# ============================================================
# LLM Gateway SDK - API Keys (copy to ../llm-gateway-sdk/.env)
# ============================================================

# Kimi / Moonshot
MOONSHOT_API_KEY=sk-your-key

# SiliconFlow
SILICONFLOW_API_KEY=sk-your-key

# Zhipu AI
ZHIPU_API_KEY=your-key

# ModelScope
MODELSCOPE_API_KEY=ms-your-key

# Alibaba Bailian (DashScope)
BAILIAN_API_KEY=sk-your-key

# Volcano Ark
VOLCANO_API_KEY=ark-your-key
VOLCANO_ENDPOINTS="ep-your-endpoint-id"

# ============================================================
# Stock Analysis Tool (copy to ./.env.research)
# ============================================================

# Optional: override LLM Gateway URL (default uses Docker service name)
# LLM_GATEWAY_URL=http://gateway:8000/v1

# Optional: override default LLM model (default: deepseek-v4-pro)
# LLM_GATEWAY_MODEL=deepseek-v4-pro

# Optional: increase LLM timeout for deep analysis
# LLM_GATEWAY_TIMEOUT=180

# Optional: custom port for web UI
# PORT=3000
